# Same Kite app as the primary bot (sxpro-bot). The access token is read from the
# primary bot's token.json (mounted read-only) - do not set KITE_ACCESS_TOKEN.
KITE_API_KEY=
# The VM's static IP is already registered for this Kite app (primary bot trades live from it).
KITE_STATIC_IP_CONFIRMED=true

# Telegram control plane (optional). Without it the engine runs headless in PAPER mode.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_ALLOWED_CHAT_IDS=

# 0/empty = initialise paper capital from Kite start-of-day funds on first run.
PAPER_START_CAPITAL=0
# Uniform reduction (<=1) of every capital-tier risk percentage.
RISK_SCALE=1.0
MAX_NEW_ENTRIES_PER_DAY=3
MAX_MARGIN_UTILIZATION_PCT=1.0
# Validated configuration (2026-11-28 replay): leg-in lock only. Credit spreads won on their
# own trades but crowded out leg-in winners; add SENSEX_BULL_PUT_CREDIT,SENSEX_BEAR_CALL_CREDIT
# to enable them (they also require >= Rs 2L capital).
ENABLED_STRATEGIES=SENSEX_LEGIN_LOCK_CALL,SENSEX_LEGIN_LOCK_PUT
MIN_STRATEGY_SCORE=55
SQUARE_OFF_TIME=15:10
LOG_LEVEL=INFO
