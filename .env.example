APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./portfolio.db

# Paper is forced on startup; live activation is an authenticated runtime action.
TRADING_MODE=paper
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=
# Set true only after registering the static order-placement IP in Kite's developer console.
KITE_STATIC_IP_CONFIRMED=false
KITE_MONITOR_POLL_INTERVAL_SECONDS=30
KITE_MONITOR_MAX_STALE_SECONDS=120
KITE_MONITOR_RETRY_MAX_SECONDS=30
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_ALLOWED_CHAT_IDS=

# Conservative, configurable initial controls (validate against broker margin and contract data).
RISK_PER_TRADE_PCT=0.0075
MAX_STRATEGY_RISK_PCT=0.01
MAX_AGGREGATE_OPEN_RISK_PCT=0.02
DAILY_LOSS_STOP_PCT=0.02
WEEKLY_DRAWDOWN_STOP_PCT=0.04
MONTHLY_DRAWDOWN_STOP_PCT=0.07
MAX_CONCURRENT_POSITIONS=2
MAX_NEW_ENTRIES_PER_DAY=3
MAX_MARGIN_UTILIZATION_PCT=0.70

# Independent normalized broker statement feed; leave blank to block LIVE entry.
BROKER_ACCOUNT_STATEMENT_PATH=
